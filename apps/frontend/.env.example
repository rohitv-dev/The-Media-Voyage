# Frontend build values. VITE_API_URL is required for production builds.
VITE_API_URL=
# Optional when authentication is hosted on a different origin from the API.
VITE_AUTH_URL=
# Optional for web builds, required for public links copied from Capacitor.
VITE_PUBLIC_APP_URL=
# Optional development proxy target; defaults to http://localhost:3000.
VITE_DEV_API_PROXY=
