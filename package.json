{
  "name": "media-voyage",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @media-voyage/frontend dev --filter @media-voyage/backend dev",
    "frontend": "pnpm --filter @media-voyage/frontend dev",
    "backend": "pnpm --filter @media-voyage/backend dev",
    "test": "pnpm --parallel --filter @media-voyage/frontend test --filter @media-voyage/backend test",
    "frontend:test": "pnpm --filter @media-voyage/frontend test",
    "backend:test": "pnpm --filter @media-voyage/backend test",
    "lint": "pnpm --filter @media-voyage/frontend lint",
    "frontend:lint": "pnpm --filter @media-voyage/frontend lint",
    "format": "prettier --write package.json pnpm-workspace.yaml prettier.config.cjs README.md apps/frontend apps/backend packages/shared",
    "format:check": "prettier --check package.json pnpm-workspace.yaml prettier.config.cjs README.md apps/frontend apps/backend packages/shared",
    "studio": "pnpm --filter @media-voyage/shared studio",
    "db:push": "pnpm --filter @media-voyage/shared db:push",
    "db:generate": "pnpm --filter @media-voyage/shared db:generate",
    "backend:build": "pnpm --filter @media-voyage/backend build",
    "refresh-catalog-metadata": "pnpm backend:build && node apps/backend/dist/refresh-catalog-metadata.cjs",
    "embed-catalog-media": "pnpm backend:build && node apps/backend/dist/embed-catalog-media.cjs",
    "frontend:build": "pnpm --filter @media-voyage/frontend build",
    "frontend:cap:sync": "pnpm --filter @media-voyage/frontend exec cap sync android",
    "frontend:cap:open": "pnpm --filter @media-voyage/frontend exec cap open android"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
